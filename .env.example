# =========================================================
# DYE CUT LAB — environment variables
# =========================================================
# Copy this file to `.env.local` for local development:
#   copy .env.example .env.local      (Windows)
#
# For Vercel: Project → Settings → Environment Variables.
# Add each variable for BOTH "Preview" and "Production".
# Never commit real values — `.env*.local` is git-ignored.
# =========================================================

# ---- Supabase (already used by the existing app) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- OpenAI (existing DICI / BABA routes) ----
OPENAI_API_KEY=

# ---- Brevo (formerly Sendinblue) — landing page confirmations ----
# Server-only. Do NOT add a NEXT_PUBLIC_ prefix to any Brevo value.
#
# BREVO_API_KEY: Brevo → SMTP & API → API Keys → v3 key (starts with xkeysib-).
#   Required for both the confirmation email and the confirmation SMS.
BREVO_API_KEY=
#
# BREVO_SENDER_EMAIL: a sender/domain verified in Brevo. Without it the
#   confirmation email is skipped (the sign-up is still saved).
BREVO_SENDER_EMAIL=
#
# BREVO_SENDER_NAME: display name on the confirmation email.
BREVO_SENDER_NAME=DYE CUT LAB
#
# BREVO_LIST_ID: numeric id of the Brevo list new sign-ups join.
#   Optional — leave blank to sync contacts without adding them to a list.
BREVO_LIST_ID=
#
# BREVO_SMS_SENDER: SMS sender ID registered in Brevo (max 11 characters,
#   letters and digits only). US carriers require a registered long
#   code / short code instead of an alphanumeric sender ID.
BREVO_SMS_SENDER=DYECUTLAB
#
# BREVO_SMS_TYPE: "marketing" (default) or "transactional".
#   The confirmation SMS contains a STOP keyword, which Brevo classifies as
#   marketing, so "marketing" is the honest default. Marketing SMS has
#   sending-hour restrictions.
BREVO_SMS_TYPE=marketing
