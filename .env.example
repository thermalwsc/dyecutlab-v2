# =========================================================
# DYE CUT LAB — environment variables
# =========================================================
# Copy this file to `.env.local` for local development:
#   copy .env.example .env.local      (Windows)
#
# For Vercel: Project → Settings → Environment Variables.
# Add each variable for BOTH "Preview" and "Production".
# Never commit real values — `.env*.local` is git-ignored.
# =========================================================

# ---- Supabase (already used by the existing app) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- OpenAI (existing DICI / BABA routes) ----
OPENAI_API_KEY=

# ---- Brevo (formerly Sendinblue) — EMAIL ONLY ----
# Server-only. Do NOT add a NEXT_PUBLIC_ prefix to any Brevo value.
# Brevo no longer sends text messages: Sendblue does (section below).
#
# BREVO_API_KEY: Brevo → SMTP & API → API Keys → v3 key (starts with xkeysib-).
#   Required for the confirmation email, the staff emails and the Brevo
#   contact mirror.
BREVO_API_KEY=
#
# BREVO_SENDER_EMAIL: a sender/domain verified in Brevo. Without it the
#   confirmation email is skipped (the sign-up is still saved).
BREVO_SENDER_EMAIL=
#
# BREVO_SENDER_NAME: display name on the confirmation email.
BREVO_SENDER_NAME=DYE CUT LAB
#
# BREVO_LIST_ID: numeric id of the Brevo list new sign-ups join.
#   Optional — leave blank to sync contacts without adding them to a list.
BREVO_LIST_ID=
#
# ---- Sendblue — SMS / iMessage (every text message we send) ----
# Server-only. Do NOT add a NEXT_PUBLIC_ prefix to any Sendblue value.
# Docs: https://docs.sendblue.com (API reference: /api).
#
# SENDBLUE_API_KEY_ID / SENDBLUE_API_KEY_SECRET: Sendblue dashboard →
#   Developer → API keys, or `sendblue show-keys` after the CLI setup.
#   Sent as the `sb-api-key-id` / `sb-api-secret-key` headers. Without
#   them texts are skipped (sign-ups and quote requests still save).
SENDBLUE_API_KEY_ID=
SENDBLUE_API_KEY_SECRET=
#
# SENDBLUE_FROM_NUMBER: a phone line on the Sendblue account, E.164
#   (+1XXXXXXXXXX). The API requires `from_number` on every send — list
#   your lines with `sendblue lines` or GET
#   https://api.sendblue.com/api/lines. NOT the same as STAFF_NOTIFY_PHONE
#   or the number in lib/contact.ts.
SENDBLUE_FROM_NUMBER=

# ---- Staff alerts for /start quote requests ----
# Who gets pinged (Sendblue SMS + Brevo email) when someone submits the
# "Start your project" form.
# STAFF_NOTIFY_PHONE: explicit E.164 phone (+1XXXXXXXXXX) that receives the
#   Sendblue staff SMS. No default — when blank the SMS alert returns
#   `skipped` (one log line) and only the Brevo email goes out. Must NOT be
#   the public business number (+14055635396): Sendblue would text itself.
#   Must be a number that has texted the Sendblue line at least once.
# STAFF_NOTIFY_EMAIL: defaults to dyecutlab@gmail.com when blank.
STAFF_NOTIFY_PHONE=
STAFF_NOTIFY_EMAIL=
